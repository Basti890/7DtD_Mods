	<!-- more resources from Bells -->
	<setattribute xpath="/blocks/block[starts-with(@name,'churchBell')]/drop[@event='Harvest']" name="name">resourceScrapBrass</setattribute>
	<setattribute xpath="/blocks/block[starts-with(@name,'churchBell')]/drop[@event='Harvest']" name="count">1250,5000</setattribute>
	
	
	<!-- Gyro drops Chassis or Parts -->
	<remove xpath="/blocks/block[@name='gyrocopterStatic']/drop[@event='Destroy']" />
	<append xpath="/blocks/block[@name='gyrocopterStatic']">
		<drop event="Destroy" name="vehicleGyroCopterChassis" count="1" prob="0.33" tag="salvageHarvest" tool_category="Disassemble"/>
		<drop event="Destroy" name="vehicleGyroCopterAccessories" count="1" prob="0.33" tag="salvageHarvest" tool_category="Disassemble"/>
	</append>
	
	
	<!-- Make Player Ovens usable as Campfire -->
