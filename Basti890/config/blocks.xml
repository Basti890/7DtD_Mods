<basti890>

	<!-- Flagstone texture for Cobble -->
	<setattribute xpath="/blocks/block[@name='cobblestoneShapes']/property[@name='Texture']" name="value">226</setattribute>
	<setattribute xpath="/blocks/block[@name='cobblestoneShapes']/property[@name='UiBackgroundTexture']" name="value">226</setattribute>


	<!-- Apiary smaller -->
	<setattribute xpath="/blocks/block[@name='cntApiary']/property[@name='MultiBlockDim']" name="value">2,2,1</setattribute>
	
	<!-- Dew Collector smaller -->
	<setattribute xpath="/blocks/block[@name='cntDewCollector']/property[@name='MultiBlockDim']" name="value">2,3,2</setattribute>


	<!-- Pickup Flashlights -->
	<append xpath="/blocks/block[starts-with(@name,'flashlight')]">
		<drop event="Destroy" name="resourceHeadlight" count="1"/>
	</append>
	
	
	<!-- Ammo boxes 14 pile -->
	<append xpath="/blocks/block[@name='palletCartonMilitaryBase']">
		<property name="Class" value="CompositeTileEntity" />
		<property class="CompositeFeatures">
			<property class="TEFeatureStorage">
				<property name="LootList" value="munitions" />
			</property>
		</property>
	</append>
	
	<!-- Blue Water barrels -->
	<append xpath="/blocks/block[@name='cntBarrelPlasticSingle00']">
		<property name="Class" value="CompositeTileEntity" />
		<property class="CompositeFeatures">
			<property class="TEFeatureStorage">
				<property name="LootList" value="waterCooler" />
			</property>
		</property>
	</append>
	
	
	<append xpath="/blocks/block[@name='cntBuriedLootStashChest']/property[@name='Tags']/@value">,lockedSafe</append>
	
	
	<!-- traps better -->
	<setattribute xpath="/blocks/block[@name='bladeTrap']/property[@name='DamageReceived']" name="value">10</setattribute>
	<setattribute xpath="/blocks/block[@name='autoTurret']/property[@name='MaxDistance']" name="value">50</setattribute>
	<setattribute xpath="/blocks/block[@name='autoTurret']/property[@name='RaySpread']" name="value">0.5</setattribute>
	<setattribute xpath="/blocks/block[@name='shotgunTurret']/property[@name='MaxDistance']" name="value">25</setattribute>
	<setattribute xpath="/blocks/block[@name='shotgunTurret']/property[@name='RaySpread']" name="value">2.5</setattribute>
	
	
	<!-- Up- & Downgrade additions -->
	<append xpath="/blocks">
		<block name="woodReinforcedShapes" shapes="All">
			<property name="DescriptionKey" value="woodGroupDesc"/>
			<property name="Material" value="MwoodReinforced_shapes"/>
			<property name="Shape" value="New"/>
			<property name="Texture" value="380"/>
			<property name="UiBackgroundTexture" value="380"/>
			<property name="FuelValue" value="500"/>
			<property name="EconomicValue" value="10"/>
			<property name="EconomicBundleSize" value="20"/>
			<property class="RepairItems">
				<property name="resourceScrapIron" value="8"/>
			</property>
			<drop event="Harvest" name="resourceScrapIron" count="8" tag="allHarvest,lumberjackHarvest"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="terrDestroyedWoodDebris" count="1" prob="0.75" stick_chance="1"/>
			<property class="UpgradeBlock">
				<property name="ToBlock" value="brickShapes"/>
				<property name="Item" value="resourceCobblestones"/>
				<property name="ItemCount" value="5"/>
				<property name="UpgradeHitCount" value="4"/>
			</property>
			<property name="DowngradeBlock" value="woodShapes"/>
			<property name="UpgradeSound" value="place_block_metal"/>
			<property name="SortOrder1" value="S000"/>
			<!-- SortOrder2 is assigned in code to keep all of the shapes in the same order for each material -->
			<property name="Group" value="Building,advBuilding"/>
			<property name="Tags" value="wood"/>
			<property name="FilterTags" value="MC_Shapes"/>
		</block>
	</append>
	<set xpath="/blocks/block[@name='woodShapes']/property[@class='UpgradeBlock']">
		<property name="ToBlock" value="woodReinforcedShapes"/>
		<property name="Item" value="resourceScrapIron"/>
		<property name="ItemCount" value="5"/>
		<property name="UpgradeHitCount" value="2"/>
	</set>
	<append xpath="/blocks/block[@name='steelShapes']">
		<property name="DowngradeBlock" value="concreteShapes"/>
	</append>


	<!-- more Gas -->
	<setattribute xpath="/blocks/block/drop[@name='ammoGasCan']" name="count">10,500</setattribute>
	
	
	<!-- more resources from Pallets -->
	<setattribute xpath="/blocks/block[starts-with(@name,'palletBag')]/drop[@event='Harvest']" name="count">10,250</setattribute>
	
	<setattribute xpath="/blocks/block[@name='palletBagCowFeedBaseFull']/drop[@event='Harvest']" name="count">5,10</setattribute>
	<setattribute xpath="/blocks/block[@name='palletBagCowFeedTile']/drop[@event='Harvest']" name="count">5,11</setattribute>
	<setattribute xpath="/blocks/block[@name='palletBagCowFeedBaseMed']/drop[@event='Harvest']" name="count">2,5</setattribute>
	<setattribute xpath="/blocks/block[@name='palletBagCowFeedCapMed']/drop[@event='Harvest']" name="count">2,5</setattribute>
	
	
	<!-- more resources from rolls -->
	<setattribute xpath="/blocks/block[@name='paperPillar100']/drop[@event='Harvest']" name="count">2500</setattribute>
	<append xpath="/blocks/block[@name='paperPillar50']">
		<drop event="Harvest" name="resourcePaper" count="500" tag="allHarvest"/>
