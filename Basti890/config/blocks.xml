	<append xpath="/blocks">
		<!-- Additional crobs -->
		<!-- NOT_A_SHAPE -->
		<block name="plantedPeas1">
			<property name="Extends" value="cropsGrowingMaster" param1="CustomIcon"/>
			<property name="CreativeMode" value="Player"/>
			<property class="PlantGrowing">
				<property name="Next" value="plantedPeas2"/>
			</property>
			<property name="CustomIcon" value="plantedBlueberry1"/>
			<property name="CustomIconTint" value="9eff99"/>
			<property name="UnlockedBy" value="craftingSeeds"/>
			<property name="Material" value="Mcorn" />
			<property name="Shape" value="GrassShort"/>
			<property name="Texture" value="573"/>
			<property name="Mesh" value="grass"/>
			<property name="PlaceAsRandomRotation" value="true"/>
			<drop event="Destroy" name="plantedPeas1" count="1"/>
			<property name="Tags" value="seedSkill,seedMulti" />
			<property name="SoundPickup" value="seeds_generic1_grab" />
			<property name="SoundPlace" value="seeds_generic1_place" />
		</block>
		<block name="plantedPeas2">
			<property name="Extends" value="plantedPeas1"/>
			<property name="CreativeMode" value="None"/>
			<property class="PlantGrowing">
				<property name="Next" value="plantedPeas3HarvestPlayer" />
			</property>
			<property name="Shape" value="Grass"/>
			<property name="Mesh" value="grass"/>
			<property name="Texture" value="377"/>
			<drop event="Destroy" name="plantedPeas1" count="1"/>
		</block>
		<block name="plantedPeas3HarvestPlayer">
			<property name="Extends" value="cropsHarvestableMaster"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="#Entities/Trees?SnakeweedPrefab.prefab"/>
			<property name="ModelOffset" value="0,0,0"/>
			<property name="DescriptionKey" value="plantedPeas3HarvestDesc"/>
			<property name="CustomIcon" value="plantedBlueberry1"/>
			<property name="CustomIconTint" value="9eff99"/>
			<property name="CreativeMode" value="None"/>
			<drop event="Harvest" name="foodCropPeas" count="2" tag="cropHarvest"/>
			<drop event="Harvest" name="foodCropPeas" prob="0.5" count="1" tag="bonusCropHarvest"/>
			<drop event="Destroy" name="plantedPeas1" count="1" prob="0.5"/>
			<!-- <property name="DowngradeBlock" value="plantedPeas1"/> -->
		</block>
		
		
		<!-- Bigger Generator -->
		<block name="Mid_Generator">
			<property name="Extends" value="generatorbank"/>
			<property name="MaxFuel" value="10000"/>
			<property name="MaxPower" value="50000"/>
			<property name="OutputPerFuel" value="46000"/>
			<property name="OutputPerStack" value="1500"/>
			<property name="UnlockedBy" value="craftingElectrician"/>
			<property name="CustomIcon" value="questGeneratorSmall"/>
			<property name="Model" value="Entities/Electrical/smallGeneratorPrefab"/>
			<property name="SortOrder2" value="0024"/>
		</block>
		<block name="Big_Generator">
			<property name="Extends" value="generatorbank"/>
			<property name="MaxFuel" value="30000"/>
			<property name="MaxPower" value="50000"/>
			<property name="OutputPerFuel" value="50000"/>
			<property name="OutputPerStack" value="5000"/>
			<property name="UnlockedBy" value="craftingElectrician"/>
