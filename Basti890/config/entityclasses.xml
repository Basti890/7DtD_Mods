<Basti890>
	<!--NOTE 1: the "TimeStayAfterDeath" works in real life seconds-->
	
	<!--Section 1 = Zombie Bodies disappear more quickly for performance reasons-->
	<!--DEFAULT is 30 seconds.-->
	<setattribute xpath="/entity_classes/entity_class/property[@name='TimeStayAfterDeath'][@value='30']" name="value">10</setattribute>

	<!--Section 2 = Dead Animals-->
	<!--DEFUALT is 300 seconds (5 minutes). 600 seconds = 10 minutes-->
	<setattribute xpath="/entity_classes/entity_class[starts-with(@name,'animal')]/property[@name='TimeStayAfterDeath']" name="value">600</setattribute>
	
	<!--Section 3 = Zombie Loot Drops-->
	<!--DEFUALT is 1200 (20mins). 3600 = 1 HOURS-->
	<setattribute xpath="/entity_classes/entity_class[starts-with(@name,'EntityLootContainer')]/property[@name='TimeStayAfterDeath']" name="value">3600</setattribute>


	<!-- more realistic food from animals -->
	<!-- Stag -->
	<setattribute xpath="/entity_classes/entity_class[@name='animalStag']/drop[@tag='butcherHarvest'][@event='Harvest']" name="count">50</setattribute>
	<!-- Bambi -->
	<setattribute xpath="/entity_classes/entity_class[@name='animalDoe']/drop[@tag='butcherHarvest'][@event='Harvest']" name="count">25</setattribute>	
	<!-- Roger (Rabbit) -->
	<setattribute xpath="/entity_classes/entity_class[@name='animalRabbit']/drop[@tag='butcherHarvest'][@event='Harvest']" name="count">3</setattribute>
	<!-- Chicken -->
	<setattribute xpath="/entity_classes/entity_class[@name='animalChicken']/drop[@tag='butcherHarvest'][@event='Harvest']" name="count">4</setattribute>
	<!-- Balu -->
	<setattribute xpath="/entity_classes/entity_class[@name='animalBear']/drop[@tag='butcherHarvest'][@event='Harvest']" name="count">100</setattribute>
	<!-- little B -->
	<setattribute xpath="/entity_classes/entity_class[@name='animalBearSmall']/drop[@tag='butcherHarvest'][@event='Harvest']" name="count">25</setattribute>
	<!-- Wolf -->
	<setattribute xpath="/entity_classes/entity_class[@name='animalWolf']/drop[@tag='butcherHarvest'][@event='Harvest']" name="count">15</setattribute>
	<!-- Coyote -->
	<setattribute xpath="/entity_classes/entity_class[@name='animalCoyote']/drop[@tag='butcherHarvest'][@event='Harvest']" name="count">7</setattribute>
	<!-- Cugar -->
	<setattribute xpath="/entity_classes/entity_class[@name='animalMountainLion']/drop[@tag='butcherHarvest'][@event='Harvest']" name="count">10</setattribute>
	<!-- Ska -->
	<setattribute xpath="/entity_classes/entity_class[@name='animalSnake']/drop[@tag='butcherHarvest'][@event='Harvest']" name="count">2</setattribute>
	<!-- Pumba -->
	<setattribute xpath="/entity_classes/entity_class[@name='animalBoar']/drop[@tag='butcherHarvest'][@event='Harvest']" name="count">60</setattribute>

</Basti890>